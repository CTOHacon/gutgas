# =============================================================================
# Gutgas — production environment (docker-compose.prod.yaml)
# Copy to .env on the server and fill in. Do NOT commit the real .env.
# =============================================================================

# --- Container image / deploy ---
REGISTRY=ghcr.io/ctohacon
TAG=latest
# Host loopback port CloudPanel reverse-proxies gutgas.eu to
APP_PORT=8091

# --- Application ---
APP_NAME=Gutgas
# Generate fresh: docker compose -f docker-compose.prod.yaml run --rm app php artisan key:generate --show
APP_KEY=
APP_URL=https://gutgas.eu
APP_LOCALE=uk
APP_FALLBACK_LOCALE=uk

# --- Database (MySQL container) ---
DB_DATABASE=gutgas
DB_USERNAME=gutgas
DB_PASSWORD=CHANGE_ME_STRONG
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT

# --- Session ---
SESSION_LIFETIME=120

# --- Mail (fill with real provider creds) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@gutgas.eu

# --- Nova Poshta (checkout delivery autocomplete) ---
NOVA_POSHTA_API_KEY=
SALESDRIVE_URL=
SALESDRIVE_API_KEY=
SALESDRIVE_SITE_OPTION=id_45
